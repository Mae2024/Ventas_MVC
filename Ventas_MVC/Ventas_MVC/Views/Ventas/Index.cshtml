@model IEnumerable<Ventas_MVC.Models.Venta>

@{
    ViewData["Title"] = "Ventas";

    var grupos = Model
        .GroupBy(v => new { v.ClienteId, Dia = v.Fecha.Date })
        .OrderByDescending(g => g.Key.Dia)
        .ThenBy(g => g.First().Cliente.Nombre)
        .ToList();
}

<h1>Ventas</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-auto">
        <label class="form-label" for="fecha">Fecha</label>
        <input type="date" id="fecha" name="fecha" value="@ViewBag.Fecha" class="form-control" />

    </div>
    <div class="col-auto">
    <label class="form-label" for="clienteId">Cliente</label>
    <select id="clienteId" name="clienteId" asp-items="ViewBag.Clientes" class="form-control">
            <option value="">Todos</option> 
        
    </select>
    </div>


        <div class="col-auto align-self-end">
            <button type="submit" class="btn btn-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        </div>


</form>



@* <p>
    <a asp-action="Create">Crear Nueva Venta</a>
</p> *@

<table class="table">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Cliente</th>
            <th>Productos</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < grupos.Count; i++)
        {
            var grupo = grupos[i];
            var primera = grupo.First();

            <tr data-bs-toggle="collapse" data-bs-target="#detalle-@i" style="cursor:pointer">
                <td>@grupo.Key.Dia.ToString("yyyy-MM-dd")</td>
                <td>@primera.Cliente.Nombre</td>
                <td>@grupo.Count() ▾</td>
                <td>$@grupo.Sum(v => v.Monto).ToString("N0")</td>
            </tr>
            <tr>
                <td colspan="4" class="p-0 border-0">
                    <div class="collapse" id="detalle-@i">
                        <table class="table table-sm mb-0 bg-light">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Cantidad</th>
                                    <th>Monto</th>
                                    <th> </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in grupo)
                                {
                                    <tr>
                                        <td>@item.Producto.Nombre</td>
                                        <td>@item.Cantidad.ToString("0.00")</td>
                                        <td>$@item.Monto.ToString("N0")</td>
                                        <td>
                                            <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                                            <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

                                            @if (!grupos.Any())
                                            {
                                                <p class="text-muted">No se encontraon ventas para este filtro</p>
                                            }