@model Ventas_MVC.Models.Venta

@{
    ViewData["Title"] = "Eliminar venta";
}

<h1>Eliminar venta</h1>

<h4>¿Seguro que querés eliminar esta venta?</h4>

<dl class="row">
    <dt class="col-sm-2">Fecha</dt>
    <dd class="col-sm-10">@Model.Fecha.ToString("yyyy-MM-dd")</dd>

    <dt class="col-sm-2">Cliente</dt>
    <dd class="col-sm-10">@Model.Cliente.Nombre</dd>

    <dt class="col-sm-2">Producto</dt>
    <dd class="col-sm-10">@Model.Producto.Nombre</dd>

    <dt class="col-sm-2">Cantidad</dt>
    <dd class="col-sm-10">@Model.Cantidad.ToString("0.00")</dd>

    <dt class="col-sm-2">Monto</dt>
    <dd class="col-sm-10">$ @Model.Monto.ToString("N0")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <input type="submit" value="Eliminar" class="btn btn-danger" />
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>